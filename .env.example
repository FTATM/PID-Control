# =====================
# Database Config
# =====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=database
DB_USER=postgres
DB_PASS=
DB_EXPOSE_PORT=5433       # Docker: port ฝั่งเครื่องสำหรับต่อ DBeaver/pgAdmin (IP-เครื่อง:5433)

# =====================
# Website Config
# =====================
WEB_PORT=8080             # Docker: port ฝั่งเครื่องของหน้าเว็บ (http://IP-เครื่อง:8080/PID/)

# =====================
# Camera Config
# =====================

CAMERAS=CAMERA_1,rtsp://@192.168.1.168:554/;CAMERA_2,rtsp://@192.168.1.122:554/

# =====================
# App Config
# =====================
APP_ENV=development
APP_DEBUG=true

# =====================
# MQTT Config (Docker: Mosquitto broker)
# เว้นว่าง MQTT_USER/MQTT_PASS = ไม่ต้องใช้รหัสผ่าน (เหมาะกับทดสอบเท่านั้น)
# =====================
MQTT_HOST=localhost       # local dev (XAMPP); Docker sets this to "mqtt" automatically
MQTT_USER=
MQTT_PASS=
MQTT_PORT=1883            # port ฝั่งเครื่องที่ ESP32/PLC ต่อเข้ามา (IP-เครื่อง:1883)
MQTT_WS_PORT=9001         # port ฝั่งเครื่องที่หน้าเว็บ (browser) ใช้ต่อ MQTT over WebSocket

# =====================
# Docker Image (ใช้กับ docker-compose.prod.yml เท่านั้น)
# =====================
IMAGE_TAG=latest          # หรือล็อกเวอร์ชัน เช่น 1.1.0
