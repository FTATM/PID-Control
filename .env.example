# =====================
# Database Config
# =====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=database
DB_USER=postgres
DB_PASS=

# =====================
# Camera Config
# =====================

CAMERAS=CAMERA_1,rtsp://@192.168.1.168:554/;CAMERA_2,rtsp://@192.168.1.122:554/

# =====================
# App Config
# =====================
APP_ENV=development
APP_DEBUG=true

# =====================
# MQTT Config (Docker: Mosquitto broker)
# เว้นว่าง MQTT_USER/MQTT_PASS = ไม่ต้องใช้รหัสผ่าน (เหมาะกับทดสอบเท่านั้น)
# =====================
MQTT_USER=
MQTT_PASS=
MQTT_PORT=1883
MQTT_WS_PORT=9001
